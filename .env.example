# Copy this file to `.env` and fill in the real values for local/static
# preview without Docker: copy assets/js/env.template.js to
# assets/js/env.js and replace the placeholder with these values yourself.
#
# In Docker, this value is instead baked into the image at build time via
# the API_BASE_URL build arg (see Dockerfile), e.g.:
#   docker build --build-arg API_BASE_URL=https://api-dev.hfive.com .

# Base URL of the real Design System Access backend (#2528) that serves
# POST /api/design-system/login, GET /api/design-system/me and
# POST /api/design-system/logout (#2525 / #2526). No trailing slash.
API_BASE_URL=
