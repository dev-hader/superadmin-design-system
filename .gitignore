node_modules
dist
.vite
*.local
# Session-local Claude state stays ignored, but skills/ and memory/ ARE
# committed — shared skills (e.g. frontend-design) and the project memory notes
# must reach teammates, and a second machine, through git. See
# .claude/memory/README.md: the memory files are NOT loaded from here, they are
# a transportable copy that has to be installed into ~/.claude.
.claude/*
!.claude/skills/
!.claude/memory/

# Local secrets/config — see .env.example
.env
.env.*
!.env.example

# Generated runtime config (see assets/js/env.template.js) — regenerated by
# Docker at image build time, or copied locally for static/non-Docker preview.
assets/js/env.js

# Local mock backend for the static preview server (`npx serve`) — recreated
# per-machine to test against, never a source of truth for the real API.
api/

# Client brand-identity handoff (93MB PDF + JPEGs) — never committed.
# The info we actually need from it is captured in
# design-system/foundations/brand-identity-source.md instead.
base_id/
.DS_Store

# OS artifacts (team works across Windows and macOS) and local logs
Thumbs.db
desktop.ini
*.log
